# Supabase browser configuration. These values are public-safe; never put service_role/secret keys in VITE_ variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Set true only on the private, master-secret-gated deployment.
VITE_ALLOW_SIGNUP=false

# Ivy Media Desk search providers (optional; configure on the private server only).
# General web search via Brave Search API.
BRAVE_SEARCH_API_KEY=
# YouTube video discovery via YouTube Data API v3.
YOUTUBE_API_KEY=
