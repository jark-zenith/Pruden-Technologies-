# Supabase browser configuration. These values are public-safe; never put service_role/secret keys in VITE_ variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Set true only on the private, master-secret-gated deployment.
VITE_ALLOW_SIGNUP=false
