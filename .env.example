# Public-safe browser configuration only. Never put service_role/secret keys in VITE_ variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Set true only on the private, master-secret-gated deployment.
VITE_ALLOW_SIGNUP=false

# Private server-only Claude configuration. Use the existing key; never expose it in frontend code.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional private server-only GitHub read-only integration for Ivy.
# Use a fine-grained token with Contents: Read-only, Metadata: Read-only, and Issues/Pull requests: Read-only for the repos Ivy should inspect.
GITHUB_TOKEN=
# Comma-separated allowlist. Default if unset: jark-zenith/Pruden-Technologies-
PRUDEN_GITHUB_REPOS=jark-zenith/Pruden-Technologies-

# Ivy Gmail OAuth token storage requires these server-only settings; do not put secrets in VITE_ variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SUPABASE_SERVICE_ROLE_KEY=
IVY_TOKEN_ENCRYPTION_KEY=

# Ivy Media Desk search providers (optional; configure on the private server only).
BRAVE_SEARCH_API_KEY=
YOUTUBE_API_KEY=

# Atlas/Nova live web research (private server only; never use a VITE_ prefix).
TAVILY_API_KEY=

# Optional private server-only Gemini text and image generation provider (Lumi Image Studio).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
