# PTMS Financial Intelligence / Daraja sandbox
# Non-secret defaults. Keep credentials empty until Safaricom sandbox setup.
DARAJA_ENABLED=false
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_BASE_URL=https://pruden-command-secure.onrender.com/api/daraja
DARAJA_CALLBACK_TOKEN=
DARAJA_OWNER_ID=
DARAJA_STK_PUSH_ENABLED=false
DARAJA_C2B_ENABLED=false
DARAJA_B2C_ENABLED=false
DARAJA_B2B_ENABLED=false

# Project-to-PTMS bridge. Generate a long random secret before enabling external project webhooks.
PTMS_FINANCE_BRIDGE_ENABLED=false
PTMS_FINANCE_BRIDGE_SECRET=
PTMS_FINANCE_OWNER_ID=

# Financial integrations remain in safe setup mode until credentials and callback URLs are verified.
